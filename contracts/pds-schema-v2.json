  "relationships": [
    "workspace 1:N plans",
    "plan 1:N plan_versions",
    "plan 1:N tasks",
    "task 1:N sessions",
    "task 1:N completions",
    "plan 1:N reviews",
    "plan.source_review_id -> reviews.id",
    "workspace.owner_id -> auth.users.id (nullable until T07)"
  ],
  "date_rules": {
    "timezone": "Asia/Seoul",
    "date_only": [
      "plans.start_date",
      "plans.end_date",
      "tasks.due_date",
      "reviews.from_date",
      "reviews.to_date"
    ],
    "timestamps": "timestamptz; ISO8601 with UTC offset on export; UI input always +09:00; render Asia/Seoul",
    "today": "Asia/Seoul calendar date",
    "range": "inclusive task.due_date between from_date and to_date, scoped to selected plan",
    "unit": "integer minute",
    "actual": "manual focused study minutes, positive, <= ceil(elapsed seconds / 60), max 1440 per session; end must not be in future",
    "browser_today": "Intl.DateTimeFormat Asia/Seoul; device clock must be correct",
    "review_today": "database now() at time zone Asia/Seoul"
  },
  "metrics": {
    "planned": "count non-deleted target tasks",
    "done": "count target tasks status=done",
    "delayed": "count target tasks status=open AND due_date < Seoul today",
    "blocked": "count DISTINCT target task IDs with non-whitespace blocker in any session",
    "estimated": "sum target task estimated_minutes",
    "actual": "sum all sessions.actual_minutes for target tasks regardless of session date",
    "difference": "actual - estimated",
    "empty": 0,
    "drilldown": "same target predicates; each task expands its execution records"
  },
  "history": {
    "plans": "after insert/update snapshot; before update increment revision; old versions preserved",
    "tasks": "soft deletion; excluded from current lists/metrics but exported",
    "completion": "unique(task_id,cycle); reopen increments cycle; current done is task state, not event count",
    "requests": "unique idempotency UUID; same action/payload returns saved result, changed payload rejects; workspace row lock serializes mutations",
    "review": "snapshot metrics plus task_ids/session_ids as_of; improvement and next plan committed in one transaction"
  },
  "security": {
    "t06": "deliberately public GET/POST Vercel API, no authentication",
    "db": "RLS enabled; no anon/authenticated grants; RPC service_role only",
    "key": "Vercel server environment only",
    "t07": "replace unscoped RPC and public API; enforce authenticated owner; see docs/T07-HANDOVER.md"
  },
  "export": {
    "format": "one JSON",
    "includes": [
      "workspaces",
      "plans",
      "plan_versions",
      "tasks including deleted",
      "sessions",
      "completions",
      "reviews"
    ],
    "excludes": [
      "internal request replay cache",
      "credentials"
    ],
    "volatile_field": "exported_at"
  }
}
